---
---

<section class="relative border-b border-swiss-200 bg-white py-12 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Column: Typographic Command Center -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Section Tracker (Swiss Monospace Tag) -->
        <div class="inline-flex items-center gap-2 border border-black bg-swiss-50 px-2.5 py-1 rounded-swiss-sm">
          <span class="h-1.5 w-1.5 bg-signal-emerald"></span>
          <span class="font-mono text-[11px] font-bold tracking-swiss-wide uppercase text-black">
            [ 01 // HỆ THỐNG PHÂN TẦNG TOPSIVI ]
          </span>
        </div>

        <!-- Authoritative Headline -->
        <h1 class="text-3xl font-black tracking-swiss-tight text-black sm:text-4xl lg:text-5xl lg:leading-[1.1]">
          Nền tảng việc làm <br class="hidden sm:inline" />
          <span class="underline decoration-signal-emerald decoration-4 underline-offset-4">phân tầng thông minh</span> <br />
          dành riêng cho sinh viên.
        </h1>

        <!-- High-readability Lead Copy -->
        <p class="max-w-xl text-sm leading-relaxed text-swiss-600 sm:text-base">
          Xóa bỏ rủi ro lừa đảo và bẫy cọc tiền. TopSiVi phân loại chính xác cơ hội việc làm theo từng giai đoạn học tập: 
          <strong>Part-time linh hoạt</strong> cho năm 1–2, 
          <strong>Thực tập chuyên ngành có dấu mộc</strong> cho năm 3–4, và 
          <strong>Fresher Full-time</strong> vững chắc ngày tốt nghiệp.
        </p>

        <!-- CTA Action Bar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a
            href="#viec-lam"
            class="inline-flex items-center justify-center gap-2 rounded-swiss-md bg-black px-6 py-3.5 text-xs font-bold uppercase tracking-swiss-wide text-white hover:bg-neutral-800 transition-colors shadow-swiss-card"
          >
            <span>Khám phá 9 vị trí việc làm</span>
            <span class="font-mono">↓</span>
          </a>

          <a
            href="#phan-tang"
            class="inline-flex items-center justify-center gap-2 rounded-swiss-md border border-swiss-300 bg-white px-5 py-3.5 text-xs font-bold uppercase tracking-swiss-wide text-black hover:border-black hover:bg-swiss-50 transition-colors"
          >
            <span>Quy chuẩn 3 nhóm sinh viên</span>
            <span class="font-mono">→</span>
          </a>
        </div>

        <!-- Structured Architectural Metrics (Swiss Table Grid) -->
        <div class="grid grid-cols-3 border border-swiss-200 rounded-swiss-md mt-6 overflow-hidden bg-swiss-50/50">
          <div class="p-3.5 border-r border-swiss-200">
            <span class="block font-mono text-xl sm:text-2xl font-black text-black">5.000+</span>
            <span class="font-mono text-[10px] uppercase tracking-wide text-swiss-500">Sinh viên kết nối</span>
          </div>
          <div class="p-3.5 border-r border-swiss-200">
            <span class="block font-mono text-xl sm:text-2xl font-black text-signal-emerald">100%</span>
            <span class="font-mono text-[10px] uppercase tracking-wide text-swiss-500">Xác thực pháp lý</span>
          </div>
          <div class="p-3.5">
            <span class="block font-mono text-xl sm:text-2xl font-black text-black">0 VNĐ</span>
            <span class="font-mono text-[10px] uppercase tracking-wide text-swiss-500">Phí hồ sơ</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Swiss Architecture Card -->
      <div class="lg:col-span-5">
        <div class="border border-black rounded-swiss-md bg-white p-5 shadow-swiss-elevated">
          <!-- Card Header -->
          <div class="flex items-center justify-between border-b border-swiss-200 pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold text-black uppercase tracking-wider">
                LỘ TRÌNH 3 GIAI ĐOẠN
              </span>
            </div>
            <span class="font-mono text-[10px] uppercase font-bold text-black bg-swiss-100 border border-swiss-300 px-2 py-0.5 rounded-swiss-sm">
              STANDARDIZED
            </span>
          </div>

          <!-- Structured 3-Tier Grid Rows -->
          <div class="divide-y divide-swiss-200 border border-swiss-200 rounded-swiss-sm overflow-hidden">
            <!-- Tier 1 -->
            <div class="p-3.5 hover:bg-swiss-50 transition-colors flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-black bg-black text-white px-2 py-1 rounded-swiss-sm">
                  01
                </span>
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-tight text-black">Năm 1–2 • Part-time</h3>
                  <p class="text-[11px] text-swiss-500">Linh hoạt theo ca, 100% không cọc tiền.</p>
                </div>
              </div>
              <span class="font-mono text-xs font-bold text-signal-emerald shrink-0">~35k/h</span>
            </div>

            <!-- Tier 2 -->
            <div class="p-3.5 hover:bg-swiss-50 transition-colors flex items-center justify-between gap-3 bg-swiss-50/40">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-black bg-signal-emerald text-white px-2 py-1 rounded-swiss-sm">
                  02
                </span>
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-tight text-black">Năm 3–4 • Thực tập</h3>
                  <p class="text-[11px] text-swiss-500">Có phụ cấp, dấu mộc tốt nghiệp & mentor.</p>
                </div>
              </div>
              <span class="font-mono text-xs font-bold text-black shrink-0">4–7M/th</span>
            </div>

            <!-- Tier 3 -->
            <div class="p-3.5 hover:bg-swiss-50 transition-colors flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-black bg-black text-white px-2 py-1 rounded-swiss-sm">
                  03
                </span>
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-tight text-black">Tốt nghiệp • Fresher</h3>
                  <p class="text-[11px] text-swiss-500">Hợp đồng chính thức, lộ trình thăng tiến.</p>
                </div>
              </div>
              <span class="font-mono text-xs font-bold text-black shrink-0">12–18M/th</span>
            </div>
          </div>

          <!-- Bottom Notice -->
          <div class="mt-4 border-t border-swiss-200 pt-3 flex items-center justify-between text-[11px] text-swiss-500">
            <span class="font-mono uppercase tracking-wide">QUY CHUẨN XÁC THỰC</span>
            <span class="font-bold text-black font-mono">100% MINH BẠCH</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
