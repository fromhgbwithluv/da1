---
import HeaderCartButton from './HeaderCartButton.svelte';
import HeaderAuthButton from './HeaderAuthButton.svelte';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === baseUrl || path === baseUrl.slice(0, -1)) {
    return currentPath === baseUrl || currentPath === baseUrl.slice(0, -1) || currentPath === '/';
  }
  return currentPath.startsWith(path);
}

const navItems = [
  { label: 'Tìm việc', href: `${baseUrl}jobs`, id: 'nav-jobs' },
  { label: 'Dịch vụ hỗ trợ', href: `${baseUrl}services`, id: 'nav-services' },
  { label: 'Về chúng tôi', href: `${baseUrl}about`, id: 'nav-about' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-obsidian-900/10 bg-alabaster-50/90 backdrop-blur-xl transition-colors">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Left: TSV TopSiVi Logo Lockup matching Sketch 1 -->
    <a
      href={baseUrl}
      class="group flex items-center gap-3 focus-visible:outline-none"
      aria-label="TopSiVi Trang chủ"
    >
      <div class="relative flex flex-col items-center justify-center rounded-xl bg-alabaster-100/80 border border-obsidian-900/10 px-2.5 py-1.5 transition-all duration-200 group-hover:border-obsidian-900/30 group-hover:bg-mint/15">
        <!-- Interlocking TSV SVG Mark -->
        <svg class="h-6 w-11" viewBox="0 0 88 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- T (Mint with dark stroke accent) -->
          <path d="M4 6H38V14H25V38H16V14H4V6Z" fill="#24c46f" />
          <path d="M6 6H38V11H25V36H19V11H6V6Z" fill="#70ffaf" />
          <!-- S (Interlocking Obsidian Charcoal) -->
          <path d="M45 12C36 12 31 16.5 31 22C31 27.5 37 29.8 43.5 31.5C48.5 32.8 51 34.2 51 37C51 39.8 47.5 41.5 42 41.5C36.5 41.5 32.5 39 31 35.5L24 39.5C27 44.5 33.5 44 42 44C52.5 44 59.5 39 59.5 32C59.5 26 53.5 23 46 21C40.5 19.5 39 18.2 39 16.5C39 14.5 41.5 13.5 45 13.5C48.5 13.5 51.5 15 53.5 17.5L59.5 13C56 10.5 51 12 45 12Z" fill="#16201c" />
          <!-- V (Mint right wing) -->
          <path d="M50 6L62 36L74 6H83L66 42H58L41 6H50Z" fill="#24c46f" />
          <path d="M52 6L62 32L72 6H79L65 39H59L45 6H52Z" fill="#70ffaf" />
        </svg>
        <span class="font-display text-[11px] font-extrabold tracking-tight text-obsidian-900 leading-none mt-0.5">
          TopSiVi
        </span>
      </div>
    </a>

    <!-- Right-aligned Navigation + Bookmark & Avatar (matching Sketch 1) -->
    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Điều hướng chính">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              id={item.id}
              class={`relative rounded-full px-4 py-2 text-sm font-semibold transition-all duration-200 ${
                active
                  ? 'bg-obsidian-900 text-mint shadow-xs'
                  : 'text-obsidian-800 hover:text-obsidian-900 hover:bg-obsidian-900/5'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Divider on desktop -->
      <div class="hidden md:block h-5 w-[1px] bg-obsidian-900/15"></div>

      <!-- Bookmark & Circular Avatar -->
      <div class="flex items-center gap-2.5">
        <HeaderCartButton client:load />
        <HeaderAuthButton client:load />

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          id="mobile-nav-toggle"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-obsidian-900/15 bg-alabaster-50 text-obsidian-900 md:hidden hover:border-obsidian-900 transition-colors"
          aria-label="Mở menu điều hướng"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-menu"
    class="hidden border-t border-obsidian-900/10 bg-alabaster-50 px-4 py-4 md:hidden shadow-swiss-elevated"
  >
    <div class="space-y-1.5">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold transition-colors ${
              active
                ? 'bg-obsidian-900 text-mint'
                : 'text-obsidian-900 hover:bg-mint/20'
            }`}
          >
            <span>{item.label}</span>
            <span class="font-mono text-xs">→</span>
          </a>
        );
      })}
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      if (hamburgerIcon && closeIcon) {
        hamburgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }
</script>
