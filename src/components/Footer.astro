---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer id="gioi-thieu" class="bg-obsidian-950 text-alabaster-100 pt-16 pb-12 border-t-2 border-obsidian-700">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
      <!-- Brand Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href={baseUrl} class="inline-flex items-center gap-3.5 group">
          <div class="flex flex-col items-center justify-center rounded-xl bg-obsidian-800 border border-obsidian-600 px-2.5 py-1.5 group-hover:border-mint transition-colors">
            <svg class="h-6 w-11" viewBox="0 0 88 44" fill="none">
              <path d="M4 6H38V14H25V38H16V14H4V6Z" fill="#70ffaf" />
              <path d="M45 12C36 12 31 16.5 31 22C31 27.5 37 29.8 43.5 31.5C48.5 32.8 51 34.2 51 37C51 39.8 47.5 41.5 42 41.5C36.5 41.5 32.5 39 31 35.5L24 39.5C27 44.5 33.5 44 42 44C52.5 44 59.5 39 59.5 32C59.5 26 53.5 23 46 21C40.5 19.5 39 18.2 39 16.5C39 14.5 41.5 13.5 45 13.5C48.5 13.5 51.5 15 53.5 17.5L59.5 13C56 10.5 51 12 45 12Z" fill="#f8faf7" />
              <path d="M50 6L62 36L74 6H83L66 42H58L41 6H50Z" fill="#70ffaf" />
            </svg>
            <span class="font-display text-[10px] font-extrabold text-alabaster-50 leading-none mt-0.5">TopSiVi</span>
          </div>
          <div>
            <span class="font-display text-xl font-extrabold tracking-tight text-alabaster-50">
              TopSiVi<span class="text-mint">.</span>
            </span>
            <p class="font-mono text-[11px] text-alabaster-300">
              Trao niềm tin • Nhận tài lộc
            </p>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-alabaster-300 leading-relaxed max-w-sm">
          Nền tảng kết nối việc làm phân tầng thông minh dành riêng cho sinh viên Việt Nam: Part-time linh hoạt cho năm 1–2, Thực tập có dấu mộc cho năm 3–4 và bệ phóng Fresher Full-time.
        </p>

        <div class="inline-flex items-center gap-2 rounded-full bg-obsidian-800 border border-obsidian-600 px-3.5 py-1.5 font-mono text-[11px] font-semibold text-mint">
          <span class="h-2 w-2 rounded-full bg-mint"></span>
          <span>100% Doanh nghiệp xác thực • 0đ phí cọc</span>
        </div>
      </div>

      <!-- Col 2: Tìm việc -->
      <div class="space-y-3">
        <h4 class="font-display text-xs font-extrabold uppercase tracking-wider text-mint">Tìm việc phân tầng</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm text-alabaster-300">
          <li><a href={`${baseUrl}jobs`} class="hover:text-mint transition-colors">Toàn bộ việc làm tuyển chọn</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-mint transition-colors">Năm 1, 2 • Part-time linh hoạt</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-mint transition-colors">Năm 3, 4 • Thực tập có dấu mộc</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-mint transition-colors">Mới tốt nghiệp • Fresher Full-time</a></li>
        </ul>
      </div>

      <!-- Col 3: Dịch vụ & Về chúng tôi -->
      <div class="space-y-3">
        <h4 class="font-display text-xs font-extrabold uppercase tracking-wider text-mint">Hệ sinh thái</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm text-alabaster-300">
          <li><a href={`${baseUrl}services`} class="hover:text-mint transition-colors font-semibold text-alabaster-50">Dịch vụ hỗ trợ CV & Phỏng vấn</a></li>
          <li><a href={`${baseUrl}services`} class="hover:text-mint transition-colors">Quảng cáo & Tuyển dụng Doanh nghiệp</a></li>
          <li><a href={`${baseUrl}about`} class="hover:text-mint transition-colors">Về chúng tôi & 5 Leader sáng lập</a></li>
          <li><a href={`${baseUrl}about#lien-he`} class="hover:text-mint transition-colors">Báo cáo vi phạm & Hỗ trợ 24/7</a></li>
        </ul>
      </div>

      <!-- Col 4: Liên hệ -->
      <div class="space-y-3">
        <h4 class="font-display text-xs font-extrabold uppercase tracking-wider text-mint">Kết nối trực tiếp</h4>
        <div class="space-y-2.5 text-xs sm:text-sm text-alabaster-300">
          <p>
            <span class="text-alabaster-400 block text-[11px] font-mono uppercase">Hotline sinh viên:</span>
            <a href="tel:19006868" class="font-mono font-bold text-alabaster-50 hover:text-mint">1900 6868 (Phím 1)</a>
          </p>
          <p>
            <span class="text-alabaster-400 block text-[11px] font-mono uppercase">Email điều hành:</span>
            <a href="mailto:admin@wherejourneybegins.web.id" class="font-mono text-xs font-semibold text-mint hover:underline">admin@wherejourneybegins.web.id</a>
          </p>
          <p class="text-xs text-alabaster-400 pt-1">
            Đại học Quốc Gia, Hà Nội & TP. Hồ Chí Minh
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-obsidian-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-alabaster-400">
      <p>
        © 2026 <strong class="text-alabaster-50">TopSiVi</strong>. Nền tảng việc làm phân tầng sinh viên Việt Nam.
      </p>
      <div class="flex items-center gap-5 font-mono text-[11px]">
        <a href={`${baseUrl}about`} class="hover:text-mint transition-colors">Cam kết bảo vệ</a>
        <span>•</span>
        <a href={`${baseUrl}services`} class="hover:text-mint transition-colors">Dịch vụ hỗ trợ</a>
        <span>•</span>
        <a href={`${baseUrl}jobs`} class="hover:text-mint transition-colors">Tuyển dụng</a>
      </div>
    </div>
  </div>
</footer>
