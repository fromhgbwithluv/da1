---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer id="gioi-thieu" class="bg-black text-white pt-16 pb-12 border-t border-neutral-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
      <!-- Col 1: Brand & Slogan -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-swiss-sm bg-white text-black font-mono font-bold text-xs">
            TSV
          </div>
          <div>
            <span class="text-lg font-black tracking-swiss-tight text-white font-sans">
              TopSiVi<span class="text-signal-emerald">.</span>
            </span>
            <p class="font-mono text-[10px] uppercase tracking-wide text-neutral-400">
              Trao niềm tin • Nhận tài lộc
            </p>
          </div>
        </div>

        <p class="text-xs text-neutral-400 leading-relaxed max-w-sm">
          TopSiVi là nền tảng khởi nghiệp kết nối việc làm thông minh dành riêng cho sinh viên Việt Nam, giải quyết bài toán việc làm thêm an toàn cho năm 1–2, thực tập chuyên ngành năm 3–4 và bệ phóng nghề nghiệp Fresher.
        </p>

        <!-- Ecosystem Tag -->
        <div class="inline-flex items-center gap-2 rounded-swiss-sm bg-neutral-900 border border-neutral-800 px-3 py-1 font-mono text-[10px] uppercase text-signal-emerald">
          <span class="h-1.5 w-1.5 bg-signal-emerald"></span>
          <span>HỆ SINH THÁI VIỆC LÀM SINH VIÊN VIỆT NAM</span>
        </div>
      </div>

      <!-- Col 2: Phân tầng sinh viên -->
      <div class="space-y-3 font-mono">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">[ 01 // CÔNG VIỆC ]</h4>
        <ul class="space-y-2 text-xs text-neutral-400">
          <li><a href={`${baseUrl}jobs`} class="hover:text-white transition-colors">Toàn bộ việc làm tuyển chọn</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-white transition-colors">Năm 1, 2: Part-time linh hoạt</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-white transition-colors">Năm 3, 4: Thực tập có dấu mộc</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-white transition-colors">Mới ra trường: Fresher Full-time</a></li>
        </ul>
      </div>

      <!-- Col 3: Dành cho Nhà tuyển dụng & Giới thiệu -->
      <div class="space-y-3 font-mono">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">[ 02 // VỀ TOPSIVI ]</h4>
        <ul class="space-y-2 text-xs text-neutral-400">
          <li><a href={`${baseUrl}about`} class="hover:text-white transition-colors">Sứ mệnh bảo vệ 100% sinh viên</a></li>
          <li><a href={`${baseUrl}about`} class="hover:text-white transition-colors">5 Leader cốt cán sáng lập</a></li>
          <li><a href={`${baseUrl}about#lien-he`} class="hover:text-white transition-colors">Liên hệ & Hỗ trợ sinh viên</a></li>
          <li><a href={`${baseUrl}jobs`} class="hover:text-white transition-colors">Đăng tin tuyển dụng (Doanh nghiệp)</a></li>
        </ul>
      </div>

      <!-- Col 4: Liên hệ & Hỗ trợ -->
      <div class="space-y-3 font-mono">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">[ 03 // LIÊN HỆ ]</h4>
        <div class="space-y-2 text-xs text-neutral-400">
          <p class="flex items-center gap-2">
            <span class="text-white font-bold">HOTLINE:</span>
            <span class="text-white">1900 6868 (PHÍM 1)</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-white font-bold">EMAIL:</span>
            <span class="text-white">contact@topsivi.vn</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-white font-bold">ZALO OA:</span>
            <span class="text-white">TopSiVi Vietnam</span>
          </p>
          <p class="text-[10px] text-neutral-500 pt-1">
            Đại học Quốc Gia, Hà Nội & Quận 10, TP. Hồ Chí Minh
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div class="mt-12 pt-8 border-t border-neutral-900 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-neutral-500">
      <p>
        © 2026 <strong>TOPSIVI</strong>. DỰ ÁN VIỆC LÀM SINH VIÊN VIỆT NAM.
      </p>
      <div class="flex items-center gap-4 text-[10px] uppercase">
        <span class="hover:text-white cursor-pointer">BẢO MẬT</span>
        <span>•</span>
        <span class="hover:text-white cursor-pointer">ĐIỀU KHOẢN</span>
        <span>•</span>
        <span class="hover:text-white cursor-pointer">BẢO VỆ ỨNG VIÊN</span>
      </div>
    </div>
  </div>
</footer>
