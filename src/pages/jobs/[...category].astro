---
import Layout from '../../layouts/Layout.astro';
import JobListings from '../../components/JobListings.svelte';

export function getStaticPaths() {
  return [
    {
      params: { category: undefined },
      props: {
        initialCategory: 'all',
        pageTitle: 'Tìm việc làm phân tầng sinh viên | TopSiVi',
        pageDescription:
          'Toàn bộ danh mục việc làm phân tầng cho sinh viên: Part-time linh hoạt, Thực tập sinh có dấu mộc & mentor, Fresher Full-time và Việc làm theo dự án. 100% doanh nghiệp xác minh, cam kết không thu cọc.',
      },
    },
    {
      params: { category: 'part-time' },
      props: {
        initialCategory: 'part-time',
        pageTitle: 'Việc làm Năm 1, 2 • Part-time linh hoạt | TopSiVi',
        pageDescription:
          'Danh mục việc làm Part-time an toàn, ca làm linh hoạt theo lịch học dành cho sinh viên Năm 1, 2. 100% doanh nghiệp xác minh, không thu cọc.',
      },
    },
    {
      params: { category: 'internship' },
      props: {
        initialCategory: 'internship',
        pageTitle: 'Việc làm Năm 3, 4 • Thực tập sinh có dấu mộc | TopSiVi',
        pageDescription:
          'Danh mục vị trí Thực tập sinh chuyên ngành dành cho sinh viên Năm 3, 4: có mentor kèm 1-1, hỗ trợ số liệu báo cáo và dấu mộc thực tập.',
      },
    },
    {
      params: { category: 'fresher' },
      props: {
        initialCategory: 'fresher',
        pageTitle: 'Việc làm Mới tốt nghiệp • Fresher Full-time | TopSiVi',
        pageDescription:
          'Cơ hội việc làm Fresher Full-time cho sinh viên mới ra trường: không đòi hỏi kinh nghiệm vô lý, ký HĐLĐ chính thức và lộ trình rõ ràng.',
      },
    },
    {
      params: { category: 'project' },
      props: {
        initialCategory: 'project',
        pageTitle: 'Việc làm theo Dự án • Thực chiến theo đầu việc | TopSiVi',
        pageDescription:
          'Danh mục việc làm theo dự án ngắn hạn cùng doanh nghiệp: nhận gói đầu việc rõ ràng, làm việc linh hoạt và thanh toán minh bạch theo sản phẩm bàn giao.',
      },
    },
  ];
}

const { initialCategory, pageTitle, pageDescription } = Astro.props;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="việc làm sinh viên, part time sinh viên, thực tập sinh, internship có dấu mộc, fresher, việc làm theo dự án, việc làm topsivi"
>
  <div class="relative overflow-hidden bg-alabaster-100 bg-organic-dots-light py-10 sm:py-14">
    <div class="pointer-events-none absolute -top-24 right-10 h-80 w-80 rounded-full bg-mint/20 blur-3xl"></div>
    <div class="pointer-events-none absolute top-1/3 -left-24 h-72 w-72 rounded-full bg-mint/15 blur-3xl"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Editorial Page Header -->
      <div class="mb-8 border-b border-obsidian-900/10 pb-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-obsidian-900/15 bg-alabaster-50 px-3.5 py-1.5 mb-3.5 shadow-xs">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-mint-500"></span>
          </span>
          <span class="font-mono text-xs font-semibold text-obsidian-900">
            Hệ thống tuyển dụng xác thực 100% • 0đ phí cọc
          </span>
        </div>
        <h1 class="font-display text-3xl font-extrabold text-obsidian-900 sm:text-5xl tracking-tight leading-tight">
          Khám phá cơ hội việc làm <span class="inline-block bg-mint px-2.5 rounded-xl">phân tầng</span>
        </h1>
        <p class="mt-3 text-sm sm:text-base text-obsidian-700 leading-relaxed max-w-3xl">
          Lọc chính xác theo giai đoạn học tập (Năm 1–2 Part-time, Năm 3–4 Thực tập có dấu mộc, Mới tốt nghiệp Fresher, Việc làm theo dự án) và 34 tỉnh thành. Ghim việc yêu thích vào giỏ hồ sơ để ứng tuyển đồng loạt trong 1 chạm.
        </p>

        <!-- Compact Feature Strip -->
        <div class="mt-5 flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-obsidian-900/15 bg-alabaster-50 px-3 py-1 text-xs font-semibold text-obsidian-800 shadow-xs">
            <span class="h-1.5 w-1.5 rounded-full bg-mint-500"></span>
            <span>34 tỉnh thành</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-obsidian-900/15 bg-alabaster-50 px-3 py-1 text-xs font-semibold text-obsidian-800 shadow-xs">
            <span class="h-1.5 w-1.5 rounded-full bg-mint-500"></span>
            <span>4 lộ trình rõ ràng</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-obsidian-900/15 bg-alabaster-50 px-3 py-1 text-xs font-semibold text-obsidian-800 shadow-xs">
            <span class="h-1.5 w-1.5 rounded-full bg-mint-500"></span>
            <span>Ứng tuyển 1 chạm qua Giỏ hồ sơ</span>
          </span>
        </div>
      </div>

      <!-- Interactive Svelte Component Island with full listings -->
      <JobListings client:load isHomePage={false} initialCategory={initialCategory} />
    </div>
  </div>
</Layout>

